# ==========================================
# FocusGuard AI — Git Ignore Configuration
# ==========================================

# ------------------------------------------
# User Privacy, Biometrics & Databases
# (Prevents leaking local session & face calibration data)
# ------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm
!backend/data/.gitkeep

# ------------------------------------------
# Python & Virtual Environments
# ------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.tox/
.nox/

# ------------------------------------------
# Frontend & Node.js
# ------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Rust & Tauri
# ------------------------------------------
target/
src-tauri/target/
**/*.rs.bk
Cargo.lock.backup

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.crt

# ------------------------------------------
# OS & IDE Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# ------------------------------------------
# Logs & Scratch Dirs
# ------------------------------------------
*.log
scratch/
